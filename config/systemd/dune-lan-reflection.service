[Unit]
Description=Dune Awakening LAN reflection host route support
After=network-online.target docker.service nftables.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/DuneAwakeningSelfHost
RuntimeDirectory=dune-lan-reflection
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/DuneAwakeningSelfHost/scripts/setup-lan-reflection.sh /opt/DuneAwakeningSelfHost/.env --seed-changed-neighbors

[Install]
WantedBy=multi-user.target
